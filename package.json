{
  "name": "examined-design",
  "version": "2.0.0",
  "description": "A single-file prototype harness and thirteen checks for designing with an AI model, so that every claim on a screen or in the record says what it rests on and a person answers for it. Checks refute; each says what it cannot see. Baseline what is there so the count can only come down.",
  "type": "module",
  "bin": {
    "examined": "./cli/examined.mjs"
  },
  "files": [
    "cli/",
    "checks/",
    "harness/",
    "backlog/",
    "skills/",
    "commands/",
    "AGENTS.md",
    "LICENSE",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/.DS_Store",
    "!checks/node_modules/**"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "playwright": "^1.47.0"
  },
  "keywords": [
    "ux",
    "design",
    "prototype",
    "ai",
    "claude-code",
    "accessibility",
    "wcag",
    "contrast",
    "audit",
    "baseline",
    "ratchet",
    "decision-log",
    "backlog"
  ],
